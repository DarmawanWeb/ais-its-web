# AIS Maritime Intelligence web app — every variable the app reads (copy to .env.local).
# In containers the same names are read at start and written to /config.js (runtime config);
# during development Vite reads them from .env files. Leave empty to use the default.

# --- API and realtime (same origin through the gateway by default, spec §3, §12) -------
# Base URL of the HTTP API; empty = same origin (/api/v2/...).
VITE_API_BASE_URL=
# Origin of the socket.io server; empty = same origin.
VITE_REALTIME_URL=
# socket.io path of the notification service (spec §9).
VITE_REALTIME_PATH=/ws
# Martin vector tiles behind the gateway (signed-in users only, spec §12).
VITE_TILES_BASE_URL=/tiles

# --- Map ----------------------------------------------------------------------------
# Dark vector basemap (MapLibre style JSON). Empty = OpenStreetMap raster fallback.
# e.g. https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json (needs a Stadia key/domain)
VITE_MAP_STYLE_URL=
# Optional light vector style used by the light theme.
VITE_MAP_STYLE_LIGHT_URL=
# Attribution shown with the vector style (HTML allowed).
VITE_MAP_STYLE_ATTRIBUTION=
# OpenStreetMap raster tiles (fallback basemap).
VITE_MAP_OSM_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Satellite raster tiles (Esri World Imagery, as in the legacy app).
VITE_MAP_SATELLITE_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# Default basemap: vector | osm | satellite (vector only when VITE_MAP_STYLE_URL is set).
VITE_MAP_DEFAULT_BASEMAP=

# --- App ----------------------------------------------------------------------------
# Default UI language: id (Bahasa Indonesia) | en.
VITE_DEFAULT_LOCALE=id
# Environment label shown in the sidebar footer (development, staging, production).
VITE_APP_ENV=development
# Version label (the Docker build sets it from APP_VERSION).
VITE_APP_VERSION=
# TanStack Query devtools in development (true | false).
VITE_QUERY_DEVTOOLS=true

# --- Development only ---------------------------------------------------------------
# Where the Vite dev/preview server proxies /api, /ws, /tiles and /.well-known
# (the Traefik gateway; the e2e tests point it at the mock server).
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Directory with the services' openapi.json files for `pnpm api:generate`.
OPENAPI_SERVICES_DIR=../../services
# Directory with methods.json / references.json for `pnpm methodology:sync`.
METHODOLOGY_DIR=../../docs/references
